types CKTOPlannerTypes {
type ckto_panel = vbox {
  name = "ckto_panel"
  visible = "[TradeRoutePlanner.IsInProfitMode]"
  spacing = 6
  margin_bottom = 6
  ignoreinvisible = yes
  layoutpolicy_horizontal = expanding

  # [SUI] START - 접이식 자동화 세부 설정 패널 (버튼 바 위쪽으로 펼침, 기본 숨김)
  vbox = {
    visible = "[GetVariableSystem.Exists('sui_ckto_opts_open')]"
    enabled = "[Or3(Not(GetVariableSystem.Exists('ckto_phase')), GetVariableSystem.HasValue('ckto_phase', 'done'), GetVariableSystem.HasValue('ckto_phase', 'no_match'))]"
    spacing = 8
    margin = { 10 8 }
    layoutpolicy_horizontal = expanding
    ignoreinvisible = yes

    background = {
      using = Background_Area_Dark
      alpha = 0.85
    }
    background = {
      using = Background_Frame
      color = { 0.55 0.50 0.40 0.7 }
    }

    hbox = {
      layoutpolicy_horizontal = expanding
      text_single = {
        text = "SUI_CKTO_OPTS_TITLE"
        default_format = "#high"
        fontsize = 14
        align = nobaseline
      }
      expand = {}
      button_close = {
        size = { 20 20 }
        onclick = "[GetVariableSystem.Clear('sui_ckto_opts_open')]"
      }
    }
  # [SUI] END
    hbox = {
      layoutpolicy_horizontal = expanding
      spacing = 6
      # [SUI] START - 최고 수익 탭에 금화 아이콘 추가 + 중앙 밀착(flowcontainer)
      button_standard = {
      layoutpolicy_horizontal = expanding
      size = { 0 28 }
      down = "[Not(GetVariableSystem.Exists('ckto_locked'))]"
      tooltip = "ckto_tab_profit_tt"
      onclick = "[GetVariableSystem.Clear('ckto_locked')]"

      flowcontainer = {
        parentanchor = center
        direction = horizontal
        spacing = 4
        alwaystransparent = yes

        icon = {
          size = { 18 18 }
          parentanchor = vcenter
          texture = "gfx/interface/icons/icon_gold.dds"
          alwaystransparent = yes
        }

        text_single = {
          parentanchor = vcenter
          text = "ckto_tab_profit"
          align = nobaseline
          alwaystransparent = yes
        }
      }
    }
      # [SUI] END
      # [SUI] START - 선택된 화물 아이콘 + 이름을 버튼 안에 중앙 밀착 표시
      button_standard = {
      layoutpolicy_horizontal = expanding
      size = { 0 28 }
      down = "[GetVariableSystem.Exists('ckto_locked')]"
      tooltip = "ckto_tab_good_tt"
      onclick = "[GetVariableSystem.Set('ckto_locked', 'yes')]"

      flowcontainer = {
        parentanchor = center
        direction = horizontal
        ignoreinvisible = yes
        spacing = 4
        alwaystransparent = yes

        icon = {
          visible = "[TradeRoutePlanner.HasSelectedTradeGoodType]"
          size = { 20 20 }
          parentanchor = vcenter
          texture = "[TradeRoutePlanner.GetSelectedTradeGoodType.GetSmallIcon]"
          alwaystransparent = yes
        }

        text_single = {
          visible = "[TradeRoutePlanner.HasSelectedTradeGoodType]"
          parentanchor = vcenter
          text = "[TradeRoutePlanner.GetSelectedTradeGoodType.GetNameNoTooltip]"
          align = nobaseline
          alwaystransparent = yes
        }

        text_single = {
          visible = "[Not(TradeRoutePlanner.HasSelectedTradeGoodType)]"
          parentanchor = vcenter
          text = "ckto_tab_good"
          align = nobaseline
          alwaystransparent = yes
        }
      }
    }
      # [SUI] END
    }
    text_single = { visible = "[And(GetVariableSystem.Exists('ckto_locked'), Not(TradeRoutePlanner.HasSelectedTradeGoodType))]" text = "ckto_pick_hint" using = Font_Size_Small }
    # [SUI] START - 불필요한 좌측 여백 제거 + 체크박스/3열 버튼이 튀어나오지 않고 비활성화 상태로 고정되도록 변경
    vbox = {
      layoutpolicy_horizontal = expanding
      spacing = 10
      ignoreinvisible = yes

      hbox = {
        layoutpolicy_horizontal = expanding
        spacing = 12

        expand = {}

        button_checkbox_label = {
          enabled = "[GetVariableSystem.Exists('ckto_locked')]"
          alpha = "[Select_float( GetVariableSystem.Exists('ckto_locked'), '(float)1.0', '(float)0.45' )]"
          onclick = "[GetVariableSystem.Toggle('ckto_side')]"
          tooltip = "ckto_side_tt"
          blockoverride "checkbox" { checked = "[GetVariableSystem.Exists('ckto_side')]" size = { 20 20 } }
          blockoverride "text" { text = "ckto_side" using = Font_Size_Small }
        }

        expand = {}
      }
      # [SUI] END
    }
  }

  # [SUI] START - 바닐라 군사 자동화 스타일 컴팩트 1행 컨트롤 (설정 패널 하단 배치)
  hbox = {
    layoutpolicy_horizontal = expanding
    spacing = 6

    # 대기 중: 무역로 자동화 실행 버튼 (정적 황금 톱니바퀴 + 라벨)
    button_primary = {
      visible = "[Or3(Not(GetVariableSystem.Exists('ckto_phase')), GetVariableSystem.HasValue('ckto_phase', 'done'), GetVariableSystem.HasValue('ckto_phase', 'no_match'))]"
      layoutpolicy_horizontal = expanding
      size = { 0 36 }
      enabled = "[And(TradeRoutePlanner.HasStartMarket, Or(Not(GetVariableSystem.Exists('ckto_locked')), TradeRoutePlanner.HasSelectedTradeGoodType))]"
      alpha = "[Select_float( And(TradeRoutePlanner.HasStartMarket, Or(Not(GetVariableSystem.Exists('ckto_locked')), TradeRoutePlanner.HasSelectedTradeGoodType)), '(float)1.0', '(float)0.4' )]"
      tooltip = "ckto_help"
      onclick = "[GetVariableSystem.Clear('ckto_crew')]"
      onclick = "[GetVariableSystem.Set('ckto_phase', 'route')]"

      flowcontainer = {
        parentanchor = center
        direction = horizontal
        spacing = 6
        alwaystransparent = yes

        icon_flat_standard_gold = {
          size = { 22 22 }
          parentanchor = vcenter
          texture = "gfx/interface/icons/flat_icons/army_automation.dds"
          alwaystransparent = yes
        }

        text_single = {
          parentanchor = vcenter
          text = "ckto_optimize"
          align = nobaseline
          alwaystransparent = yes
        }
      }
    }

    # 실행 중: 황금 회전 톱니바퀴 + 작업 중 표시 (enabled=no 없이 황금색 유지)
    button_primary = {
      visible = "[Not(Or3(Not(GetVariableSystem.Exists('ckto_phase')), GetVariableSystem.HasValue('ckto_phase', 'done'), GetVariableSystem.HasValue('ckto_phase', 'no_match')))]"
      layoutpolicy_horizontal = expanding
      size = { 0 36 }
      down = yes
      alwaystransparent = yes

      flowcontainer = {
        parentanchor = center
        direction = horizontal
        spacing = 6
        alwaystransparent = yes

        icon_flat_standard_gold = {
          size = { 22 22 }
          parentanchor = vcenter
          texture = "gfx/interface/colors/black.dds"
          alwaystransparent = yes

          modify_texture = {
            name = "sui_ckto_spin"
            blend_mode = alphaMultiply
            texture = "gfx/interface/icons/flat_icons/army_automation.dds"
            rotate_uv = 0
          }

          state = {
            name = sui_spin_a
            next = sui_spin_b
            trigger_on_create = yes
            duration = 2.0

            modify_texture = {
              name = "sui_ckto_spin"
              rotate_uv = -360
            }
          }

          state = {
            name = sui_spin_b
            next = sui_spin_a
            duration = 0

            modify_texture = {
              name = "sui_ckto_spin"
              rotate_uv = 0
            }
          }
        }

        text_single = {
          parentanchor = vcenter
          text = "ckto_working"
          align = nobaseline
          alwaystransparent = yes
        }
      }
    }

    # 우측 설정 토글 버튼 (바닐라 자동 부대 설정 깃펜+톱니 아이콘)
    button_standard = {
      size = { 36 36 }
      down = "[GetVariableSystem.Exists('sui_ckto_opts_open')]"
      onclick = "[GetVariableSystem.Toggle('sui_ckto_opts_open')]"
      tooltip = "SUI_CKTO_OPTS_TT"

      button_edit_automation = {
        parentanchor = center
        alwaystransparent = yes
        size = { 26 26 }
      }
    }
  }

  # 비활성화 시 원인별 안내 라벨 (기본 무역품과 동일한 브러시 라벨 + 붉은 색조 + 펄스 애니메이션)
  text_label_center = {
    visible = "[Not( TradeRoutePlanner.HasStartMarket )]"
    layoutpolicy_horizontal = expanding
    text = "SUI_CKTO_HINT_NO_MARKET"
    using = Font_Size_Small
    margin_top = 6
    margin_bottom = 2

    background = {
      using = Background_Label
      color = { 0.72 0.14 0.14 0.85 }
      margin = { 16 4 }
    }

    state = {
      name = sui_hint_pulse_down
      next = sui_hint_pulse_up
      trigger_on_create = yes
      alpha = 0.55
      duration = 0.9
      using = Animation_Curve_Default
    }
    state = {
      name = sui_hint_pulse_up
      next = sui_hint_pulse_down
      alpha = 1.0
      duration = 0.9
      using = Animation_Curve_Default
    }
  }
  text_label_center = {
    visible = "[And( TradeRoutePlanner.HasStartMarket, And( GetVariableSystem.Exists('ckto_locked'), Not( TradeRoutePlanner.HasSelectedTradeGoodType ) ) )]"
    layoutpolicy_horizontal = expanding
    text = "SUI_CKTO_HINT_NO_GOOD"
    using = Font_Size_Small
    margin_top = 6
    margin_bottom = 2

    background = {
      using = Background_Label
      color = { 0.72 0.14 0.14 0.85 }
      margin = { 16 4 }
    }

    state = {
      name = sui_hint_pulse_down2
      next = sui_hint_pulse_up2
      trigger_on_create = yes
      alpha = 0.55
      duration = 0.9
      using = Animation_Curve_Default
    }
    state = {
      name = sui_hint_pulse_up2
      next = sui_hint_pulse_down2
      alpha = 1.0
      duration = 0.9
      using = Animation_Curve_Default
    }
  }
  # [SUI] END
  text_single = { visible = "[GetVariableSystem.HasValue('ckto_phase', 'no_match')]" text = "ckto_no_match" using = Font_Size_Small }
  # [SUI] START - 하단 중복 수익률 텍스트 숨김
  text_single = { visible = no text = "ckto_result" using = Font_Size_Small }
  # [SUI] END
  # Zero-size host so the hidden search steps never take layout space.
  widget = {
    size = { 0 0 }
    widget = {
    size = { 0 0 }
    alwaystransparent = yes
    visible_at_creation = no
    
    visible = "[GetVariableSystem.HasValue('ckto_phase', 'route')]"
    state = {
      name = _show
      duration = 0.12
      on_finish = "[PdxGuiWidget.TriggerAnimation(Select_CString(GetVariableSystem.HasValue('ckto_phase', 'route'), 'ckto_commit', 'ckto_skip'))]"
    }
    state = { name = ckto_commit on_start = "[GetVariableSystem.Set('ckto_row', '0')]"
on_start = "[GetVariableSystem.Set('ckto_phase', 'scan')]" }
    state = { name = ckto_skip alpha = 1 } # no-op property: an empty state logs an error when triggered
    state = {
      name = _hide
      duration = 0
    }
  }
container = { name = "ckto_apply_route" datamodel = "[TradeRoutePlanner.GetBestTrades]" item = { widget = {
    size = { 0 0 }
    alwaystransparent = yes
    visible_at_creation = no
    
    visible = "[And(And(GetVariableSystem.HasValue('ckto_phase', 'scan'), GetVariableSystem.HasValue('ckto_row', IntToString(PdxGuiWidget.GetIndexInDataModel))), And(And(Or(And(GetVariableSystem.Exists('ckto_locked'), ObjectsEqual(RecommendedGood.GetTradeGoodType, TradeRoutePlanner.GetSelectedTradeGoodType)), And(Not(GetVariableSystem.Exists('ckto_locked')), EqualTo_int32(PdxGuiWidget.GetIndexInDataModel, '(int32)0'))), GreaterThan_CFixedPoint(RecommendedGood.GetProfit, '(CFixedPoint)0')), Or(GetVariableSystem.Exists('ckto_locked'), GreaterThan_CFixedPoint(RecommendedGood.GetProfit, TradeRouteDraft.GetTotalExpectedProfit))))]"
    state = {
      name = _show
      duration = 0.12
      on_finish = "[PdxGuiWidget.TriggerAnimation(Select_CString(And(And(GetVariableSystem.HasValue('ckto_phase', 'scan'), GetVariableSystem.HasValue('ckto_row', IntToString(PdxGuiWidget.GetIndexInDataModel))), And(And(Or(And(GetVariableSystem.Exists('ckto_locked'), ObjectsEqual(RecommendedGood.GetTradeGoodType, TradeRoutePlanner.GetSelectedTradeGoodType)), And(Not(GetVariableSystem.Exists('ckto_locked')), EqualTo_int32(PdxGuiWidget.GetIndexInDataModel, '(int32)0'))), GreaterThan_CFixedPoint(RecommendedGood.GetProfit, '(CFixedPoint)0')), Or(GetVariableSystem.Exists('ckto_locked'), GreaterThan_CFixedPoint(RecommendedGood.GetProfit, TradeRouteDraft.GetTotalExpectedProfit)))), 'ckto_commit', 'ckto_skip'))]"
    }
    state = { name = ckto_commit on_start = "[GetScriptedGui('ckto_remember_good').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('good', RecommendedGood.GetTradeGoodType.MakeScope).End)]"
on_start = "[TradeRoutePlanner.AddRecommendedTradeToRoute(RecommendedGood.Self)]"
on_start = "[GetVariableSystem.Set('ckto_phase', 'primary')]" }
    state = { name = ckto_skip alpha = 1 } # no-op property: an empty state logs an error when triggered
    state = {
      name = _hide
      duration = 0
    }
  } } }
container = { name = "ckto_skip_trade" datamodel = "[TradeRoutePlanner.GetBestTrades]" item = { widget = {
    size = { 0 0 }
    alwaystransparent = yes
    visible_at_creation = no
    
    visible = "[And(And(GetVariableSystem.HasValue('ckto_phase', 'scan'), GetVariableSystem.HasValue('ckto_row', IntToString(PdxGuiWidget.GetIndexInDataModel))), Not(And(And(Or(And(GetVariableSystem.Exists('ckto_locked'), ObjectsEqual(RecommendedGood.GetTradeGoodType, TradeRoutePlanner.GetSelectedTradeGoodType)), And(Not(GetVariableSystem.Exists('ckto_locked')), EqualTo_int32(PdxGuiWidget.GetIndexInDataModel, '(int32)0'))), GreaterThan_CFixedPoint(RecommendedGood.GetProfit, '(CFixedPoint)0')), Or(GetVariableSystem.Exists('ckto_locked'), GreaterThan_CFixedPoint(RecommendedGood.GetProfit, TradeRouteDraft.GetTotalExpectedProfit)))))]"
    state = {
      name = _show
      duration = 0.03
      on_finish = "[PdxGuiWidget.TriggerAnimation(Select_CString(And(And(GetVariableSystem.HasValue('ckto_phase', 'scan'), GetVariableSystem.HasValue('ckto_row', IntToString(PdxGuiWidget.GetIndexInDataModel))), Not(And(And(Or(And(GetVariableSystem.Exists('ckto_locked'), ObjectsEqual(RecommendedGood.GetTradeGoodType, TradeRoutePlanner.GetSelectedTradeGoodType)), And(Not(GetVariableSystem.Exists('ckto_locked')), EqualTo_int32(PdxGuiWidget.GetIndexInDataModel, '(int32)0'))), GreaterThan_CFixedPoint(RecommendedGood.GetProfit, '(CFixedPoint)0')), Or(GetVariableSystem.Exists('ckto_locked'), GreaterThan_CFixedPoint(RecommendedGood.GetProfit, TradeRouteDraft.GetTotalExpectedProfit))))), 'ckto_commit', 'ckto_skip'))]"
    }
    state = { name = ckto_commit on_start = "[GetVariableSystem.Set('ckto_row', IntToString(Add_int32(PdxGuiWidget.GetIndexInDataModel, '(int32)1')))]" }
    state = { name = ckto_skip alpha = 1 } # no-op property: an empty state logs an error when triggered
    state = {
      name = _hide
      duration = 0
    }
  } } }
widget = {
    size = { 0 0 }
    alwaystransparent = yes
    visible_at_creation = no
    
    visible = "[And(And(GetVariableSystem.HasValue('ckto_phase', 'scan'), GetVariableSystem.HasValue('ckto_row', IntToString(GetDataModelSize(TradeRoutePlanner.GetBestTrades)))), Not(GetVariableSystem.Exists('ckto_locked')))]"
    state = {
      name = _show
      duration = 0.12
      on_finish = "[PdxGuiWidget.TriggerAnimation(Select_CString(And(And(GetVariableSystem.HasValue('ckto_phase', 'scan'), GetVariableSystem.HasValue('ckto_row', IntToString(GetDataModelSize(TradeRoutePlanner.GetBestTrades)))), Not(GetVariableSystem.Exists('ckto_locked'))), 'ckto_commit', 'ckto_skip'))]"
    }
    state = { name = ckto_commit on_start = "[GetVariableSystem.Set('ckto_phase', 'fill_start')]" }
    state = { name = ckto_skip alpha = 1 } # no-op property: an empty state logs an error when triggered
    state = {
      name = _hide
      duration = 0
    }
  }
widget = {
    size = { 0 0 }
    alwaystransparent = yes
    visible_at_creation = no
    
    visible = "[And(And(GetVariableSystem.HasValue('ckto_phase', 'scan'), GetVariableSystem.HasValue('ckto_row', IntToString(GetDataModelSize(TradeRoutePlanner.GetBestTrades)))), GetVariableSystem.Exists('ckto_locked'))]"
    state = {
      name = _show
      duration = 0.12
      on_finish = "[PdxGuiWidget.TriggerAnimation(Select_CString(And(And(GetVariableSystem.HasValue('ckto_phase', 'scan'), GetVariableSystem.HasValue('ckto_row', IntToString(GetDataModelSize(TradeRoutePlanner.GetBestTrades)))), GetVariableSystem.Exists('ckto_locked')), 'ckto_commit', 'ckto_skip'))]"
    }
    state = { name = ckto_commit on_start = "[GetVariableSystem.Set('ckto_phase', 'no_match')]" }
    state = { name = ckto_skip alpha = 1 } # no-op property: an empty state logs an error when triggered
    state = {
      name = _hide
      duration = 0
    }
  }
widget = {
    size = { 0 0 }
    alwaystransparent = yes
    visible_at_creation = no
    
    visible = "[And(GetVariableSystem.HasValue('ckto_phase', 'primary'), GetVariableSystem.Exists('ckto_locked'))]"
    state = {
      name = _show
      duration = 0.12
      on_finish = "[PdxGuiWidget.TriggerAnimation(Select_CString(And(GetVariableSystem.HasValue('ckto_phase', 'primary'), GetVariableSystem.Exists('ckto_locked')), 'ckto_commit', 'ckto_skip'))]"
    }
    state = { name = ckto_commit on_start = "[GetVariableSystem.Set('ckto_phase', 'add_primary')]" }
    state = { name = ckto_skip alpha = 1 } # no-op property: an empty state logs an error when triggered
    state = {
      name = _hide
      duration = 0
    }
  }
widget = {
    size = { 0 0 }
    alwaystransparent = yes
    visible_at_creation = no
    
    visible = "[And(GetVariableSystem.HasValue('ckto_phase', 'primary'), Not(GetVariableSystem.Exists('ckto_locked')))]"
    state = {
      name = _show
      duration = 0.12
      on_finish = "[PdxGuiWidget.TriggerAnimation(Select_CString(And(GetVariableSystem.HasValue('ckto_phase', 'primary'), Not(GetVariableSystem.Exists('ckto_locked'))), 'ckto_commit', 'ckto_skip'))]"
    }
    state = { name = ckto_commit on_start = "[GetVariableSystem.Set('ckto_phase', 'fill_start')]" }
    state = { name = ckto_skip alpha = 1 } # no-op property: an empty state logs an error when triggered
    state = {
      name = _hide
      duration = 0
    }
  }
widget = {
    size = { 0 0 }
    alwaystransparent = yes
    visible_at_creation = no
    
    visible = "[And(GetVariableSystem.HasValue('ckto_phase', 'add_primary'), TradeRoutePlanner.CanAddTradeGoodTypeToRoute(GetPlayer.MakeScope.Var('ckto_good').TradeGoodType))]"
    state = {
      name = _show
      duration = 0.12
      on_finish = "[PdxGuiWidget.TriggerAnimation(Select_CString(And(GetVariableSystem.HasValue('ckto_phase', 'add_primary'), TradeRoutePlanner.CanAddTradeGoodTypeToRoute(GetPlayer.MakeScope.Var('ckto_good').TradeGoodType)), 'ckto_commit', 'ckto_skip'))]"
    }
    state = { name = ckto_commit on_start = "[TradeRoutePlanner.AddOrReplaceTradeGoodType(GetPlayer.MakeScope.Var('ckto_good').TradeGoodType)]"
on_start = "[GetVariableSystem.Set('ckto_phase', 'check_primary')]" }
    state = { name = ckto_skip alpha = 1 } # no-op property: an empty state logs an error when triggered
    state = {
      name = _hide
      duration = 0
    }
  }
widget = {
    size = { 0 0 }
    alwaystransparent = yes
    visible_at_creation = no
    
    visible = "[And(GetVariableSystem.HasValue('ckto_phase', 'add_primary'), TradeRoutePlanner.RouteContainsTradeGood(GetPlayer.MakeScope.Var('ckto_good').TradeGoodType))]"
    state = {
      name = _show
      duration = 0.12
      on_finish = "[PdxGuiWidget.TriggerAnimation(Select_CString(And(GetVariableSystem.HasValue('ckto_phase', 'add_primary'), TradeRoutePlanner.RouteContainsTradeGood(GetPlayer.MakeScope.Var('ckto_good').TradeGoodType)), 'ckto_commit', 'ckto_skip'))]"
    }
    state = { name = ckto_commit on_start = "[TradeRoutePlanner.MoveTradeGoodToIndex(GetPlayer.MakeScope.Var('ckto_good').TradeGoodType, '(int32)0')]"
on_start = "[GetVariableSystem.Set('ckto_phase', 'check_primary')]" }
    state = { name = ckto_skip alpha = 1 } # no-op property: an empty state logs an error when triggered
    state = {
      name = _hide
      duration = 0
    }
  }
widget = {
    size = { 0 0 }
    alwaystransparent = yes
    visible_at_creation = no
    
    visible = "[And(And(GetVariableSystem.HasValue('ckto_phase', 'check_primary'), TradeRoutePlanner.IsPrimaryGood(GetPlayer.MakeScope.Var('ckto_good').TradeGoodType)), GreaterThan_CFixedPoint(TradeRouteDraft.GetPurchasedAmountOfGood(GetPlayer.MakeScope.Var('ckto_good').TradeGoodType), '(CFixedPoint)0'))]"
    state = {
      name = _show
      duration = 0.12
      on_finish = "[PdxGuiWidget.TriggerAnimation(Select_CString(And(And(GetVariableSystem.HasValue('ckto_phase', 'check_primary'), TradeRoutePlanner.IsPrimaryGood(GetPlayer.MakeScope.Var('ckto_good').TradeGoodType)), GreaterThan_CFixedPoint(TradeRouteDraft.GetPurchasedAmountOfGood(GetPlayer.MakeScope.Var('ckto_good').TradeGoodType), '(CFixedPoint)0')), 'ckto_commit', 'ckto_skip'))]"
    }
    state = { name = ckto_commit on_start = "[GetVariableSystem.Set('ckto_phase', 'trim')]" }
    state = { name = ckto_skip alpha = 1 } # no-op property: an empty state logs an error when triggered
    state = {
      name = _hide
      duration = 0
    }
  }
widget = {
    size = { 0 0 }
    alwaystransparent = yes
    visible_at_creation = no
    
    visible = "[And(GetVariableSystem.HasValue('ckto_phase', 'trim'), LessThanOrEqualTo_int32(GetDataModelSize(TradeRouteDraft.GetTradeGoods), '(int32)1'))]"
    state = {
      name = _show
      duration = 0.12
      on_finish = "[PdxGuiWidget.TriggerAnimation(Select_CString(And(GetVariableSystem.HasValue('ckto_phase', 'trim'), LessThanOrEqualTo_int32(GetDataModelSize(TradeRouteDraft.GetTradeGoods), '(int32)1')), 'ckto_commit', 'ckto_skip'))]"
    }
    state = { name = ckto_commit on_start = "[GetVariableSystem.Set('ckto_phase', 'fill_start')]" }
    state = { name = ckto_skip alpha = 1 } # no-op property: an empty state logs an error when triggered
    state = {
      name = _hide
      duration = 0
    }
  }
container = { name = "ckto_trim_last" datamodel = "[TradeRouteDraft.GetTradeGoods]" item = { widget = {
    size = { 0 0 }
    alwaystransparent = yes
    visible_at_creation = no
    
    visible = "[And(And(GetVariableSystem.HasValue('ckto_phase', 'trim'), Not(LessThanOrEqualTo_int32(GetDataModelSize(TradeRouteDraft.GetTradeGoods), '(int32)1'))), EqualTo_int32(PdxGuiWidget.GetIndexInDataModel, Subtract_int32(GetDataModelSize(TradeRouteDraft.GetTradeGoods), '(int32)1')))]"
    state = {
