types SimpleUIDistrictCodexTypes
{
	type sui_district_codex_window = window {
		name = "sui_district_codex_window"
		visible = "[GetVariableSystem.Exists( 'sui_district_codex_open' )]"
		parentanchor = center
		size = { 640 660 }
		layer = top
		movable = yes

		using = Window_Background
