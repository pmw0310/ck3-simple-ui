					# MUI 스타일 통합 아코디언 카드 (헤더 전체 클릭 토글)
					vbox = {
						layoutpolicy_horizontal = expanding
						margin = { 10 6 }
						spacing = 6

						background = {
							using = Background_Area_Dark
							alpha = 0.78
						}
						background = {
							using = Background_Frame
							color = { 0.48 0.44 0.36 0.6 }
						}

						widget = {
							layoutpolicy_horizontal = fixed
							layoutpolicy_vertical = fixed
							size = { 474 38 }

							button = {
								size = { 100% 100% }
								onclick = "[GetVariableSystem.Toggle( 'sui_codex_d_mandala_district' )]"
							}

							hbox = {
								size = { 100% 100% }
								spacing = 10

								icon = {
									size = { 34 34 }
									texture = "gfx/interface/colors/white.dds"
									color = { 0.42 0.52 0.60 1.0 }
									using = tooltip_ne
									tooltip = "mandala_district_desc"
									modify_texture = {
										texture = "gfx/interface/icons/building_types/district_buildings/mandala_district.dds"
										blend_mode = alphamultiply
									}
								}

								text_single = {
									min_width = 130
									max_width = 140
									default_format = "#high"
									align = left|nobaseline
									text = "mandala_district"
								}

								text_multi = {
									layoutpolicy_horizontal = expanding
									autoresize = yes
									max_width = 255
									using = Font_Size_Small
									text = "SUI_CODEX_R_MANDALA"
								}

								widget = {
									size = { 26 26 }
									alwaystransparent = yes

									icon = {
										visible = "[Not( GetVariableSystem.Exists( 'sui_codex_d_mandala_district' ) )]"
										parentanchor = center
										size = { 16 16 }
										texture = "gfx/interface/icons/symbols/triangle_down.dds"
										alwaystransparent = yes
									}
									icon = {
										visible = "[GetVariableSystem.Exists( 'sui_codex_d_mandala_district' )]"
										parentanchor = center
										size = { 16 16 }
