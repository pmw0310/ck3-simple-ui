									modify_texture = {
										texture = "gfx/interface/icons/building_types/district_buildings/entertainment_square_district.dds"
										blend_mode = alphamultiply
									}
								}

								text_single = {
									min_width = 130
									max_width = 140
									default_format = "#high"
									align = left|nobaseline
									text = "entertainment_district"
